          "linea_de_ayuda": { "type": "string" },
          "grupo_de_pago": { "type": "string" },
          "importe_ayuda": { "type": "number", "default": 0.00 },
          "importe_penalizacion_por_campo": { "type": "string", "default": "" },
          "importe_penalizacion_por_fecha": { "type": "number", "default": 0.00 },
          "importe_penalizacion_omision_parcelas": { "type": "string", "default": "" },
          "importe_reduccion_por_capping": { "type": "number", "default": 0.00 },
          "importe_detraer_rebasamiento": { "type": "number", "default": 0.00 },
          "importe_detraer_disciplina_financiera": { "type": "number", "default": 0.00 },
          "importe_pago": { "type": "number", "default": 0.00 },
          "importe_detraer_condicionalidad": { "type": "string", "default": "" }
        }
      }
