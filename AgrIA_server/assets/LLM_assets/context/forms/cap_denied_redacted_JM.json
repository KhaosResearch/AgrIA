{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResolucionAyudaSolicitante",
  "description": "JSON Schema extracted from Resolución de Ayuda al Solicitante document (Junta de Andalucía)",
  "type": "object",
  "properties": {
    "encabezado_documento": {
      "type": "object",
      "properties": {
        "organismos_emisores": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "Unión Europea - Fondo Europeo Agrícola de Desarrollo Rural",
            "Junta de Andalucía",
            "Gobierno de España - Ministerio de Agricultura, Pesca y Alimentación",
            "Consejería de Agricultura, Pesca, Agua y Desarrollo Rural - D.G. de Ayudas Directas y de Mercados - Servicio de Ayudas"
          ]
        },
        "registro_salida": {
          "type": "object",
          "properties": {
            "numero": { "type": "string", "default": "" },
            "fecha": { "type": "string", "format": "date", "default": "2026-06-05" }
          }
        },
        "datos_identificativos": {
          "type": "object",
          "properties": {
            "titulo": { "type": "string", "default": "RESOLUCIÓN DE AYUDA AL SOLICITANTE / CAMPAÑA 2024" },
            "numero_expediente": { "type": "string", "default": "01202409001218300211755" },
            "nif": { "type": "string", "default": "" },
            "numero_comunicacion": { "type": "string", "default": "654 / 2026" },
            "fecha_presentacion_su": { "type": "string", "format": "date", "default": "2024-03-11" },
            "fecha_resolucion": { "type": "string", "format": "date", "default": "2026-06-05" }
          }
        }
      }
    },
    "cuerpo_resolucion": {
      "type": "object",
      "properties": {
        "tenor_literal": {
          "type": "object",
          "properties": {
            "referencia": { "type": "string", "default": "DGADM/SAD/C2024/Nº 654/2026" },
            "campana_referenciada": { "type": "string", "default": "2024/2025" },
            "antecedentes_de_hecho": {
              "type": "array",
              "items": { "type": "string" },
              "default": [
                "PRIMERO.- Que por la persona interesada fue presentada una Solicitud Única de Ayudas correspondiente a la campaña 2024/2025.",
                "SEGUNDO.- Realizados los correspondientes controles administrativos y sobre el terreno a la solicitud de ayuda anteriormente referenciada.",
                "TERCERO.- Realizadas las comunicaciones de las incidencias administrativas.",
                "CUARTO.- Realizadas las comunicaciones relativas al resultado de los controles sobre el terreno realizados."
              ]
            },
            "normativa_aplicable": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Relación de Reglamentos UE, Leyes, Reales Decretos y Órdenes de aplicación"
            },
            "fundamentos_de_derecho": {
              "type": "array",
              "items": { "type": "string" }
            },
            "resuelve": {
              "type": "object",
              "properties": {
                "notificacion_recursos": { "type": "string", "default": "Recurso de reposición en el plazo de un mes desde el día siguiente a la notificación o recurso contencioso-administrativo." },
                "firmante_director_general": { "type": "string", "default": "Raquel María Espín Crespo" }
              }
            }
          }
        }
      }
    },
    "caracter_de_la_resolucion": {
      "type": "array",
      "description": "Tabla de líneas de ayuda y carácter de la resolución (Denegación u Otorgamiento)",
      "items": {
        "type": "object",
        "properties": {
          "linea_de_ayuda": { "type": "string" },
          "caracter_de_la_resolucion": { "type": "string" },
          "es_denegada": { "type": "boolean", "default": true }
